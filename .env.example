# FactoryIQ Enterprise Configuration Template
PROJECT_NAME="FactoryIQ — Industrial AI & 3D Digital Twin Platform"
ENVIRONMENT=development
DEBUG=True

# Security (Change this in production!)
SECRET_KEY=factoryiq-industrial-enterprise-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database Mode (Set USE_SQLITE=False to connect to PostgreSQL/TimescaleDB)
USE_SQLITE=True
SQLITE_DB_PATH=factoryiq.db

# PostgreSQL / TimescaleDB Configuration
POSTGRES_USER=factory_admin
POSTGRES_PASSWORD=factory_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=factoryiq

# Factory Simulator Parameters
MACHINES_COUNT=24
SIMULATION_INTERVAL_SECONDS=1.0
OEE_CALCULATION_INTERVAL_SECONDS=15
WORK_ORDER_INTERVAL_SECONDS=30
